        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV usuarios_lectura" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${__P(datadir,data)}/usuarios_lectura.csv</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="variableNames">correo,password</stringProp>
        </CSVDataSet>
        <hashTree />
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SETUP_identidad_lectura" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters" />
          <stringProp name="filename" />
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
try {
  def email=vars.get('correo'); def password=vars.get('password')
  assert email &amp;&amp; email.endsWith('@carga.qa.invalid') &amp;&amp; password &amp;&amp; email != '&lt;EOF&gt;'
  vars.put('qa_run_id',props.getProperty('run_id','gui-validacion'))
  vars.put('qa_profile','lectura'); vars.put('qa_vu',vars.get('qa_profile')+'-'+ctx.getThreadNum())
  vars.put('qa_job_id',''); vars.put('qa_app_id',''); vars.put('pages','1'); vars.putObject('seenJobs',new HashSet())
  synchronized(props) {
    def key='qa24.accounts.'+vars.get('qa_run_id')
    def accounts=props.get(key)
    if (accounts == null) { accounts=new HashMap();props.put(key,accounts) }
    def previous=accounts.putIfAbsent(email,vars.get('qa_vu'))
    assert previous == null || previous == vars.get('qa_vu')
  }
  SampleResult.setResponseCode('200');SampleResult.setResponseMessage('Cuenta ficticia independiente asignada');SampleResult.setSuccessful(true)
} catch (Throwable ignored) {
  SampleResult.setResponseCode('500');SampleResult.setResponseMessage('Asignacion CSV invalida o cuenta compartida');SampleResult.setSuccessful(false);SampleResult.setStopThread(true)
}
</stringProp>
        </JSR223Sampler>
