              <stringProp name="script">import groovy.json.JsonSlurper
try {
  assert prev.getResponseCode() == '200'
  def data = new JsonSlurper().parseText(prev.getResponseDataAsString()).data
  assert data.token instanceof String &amp;&amp; data.token.size() &gt; 5
  assert data.usuario_id instanceof Number &amp;&amp; data.usuario_id &gt; 0
  vars.put('qa_user_id',data.usuario_id.toString())
  vars.put('token', data.token)
} catch (Throwable ignored) {
  AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Login sin token valido; VU detenido')
  vars.remove('token'); prev.setStopThread(true)
}</stringProp>
